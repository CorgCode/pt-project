FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv/inference
COPY deploy/inference/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY deploy/inference/service.py .
USER 10001:10001
EXPOSE 8001
CMD ["uvicorn", "service:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--no-access-log", "--no-proxy-headers"]
